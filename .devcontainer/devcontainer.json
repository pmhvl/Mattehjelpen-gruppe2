{
  "name": "MatteHjelpen",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "pip install -r requirements.txt && ([ -f .env ] || cp .env.example .env)",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "MatteHjelpen",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["GitHub.copilot", "GitHub.copilot-chat"]
    }
  }
}
